generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OPERATOR
  CUSTOMER
  COURIER
}

enum CustomerType {
  PERSON
  COMPANY
}

enum ShipmentStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_DEPOT
  IN_ROUTE
  DELIVERED
  NOT_DELIVERED
  RESCHEDULED
  CANCELED
}

enum ShipmentPriority {
  NORMAL
  HIGH
}

enum ShipmentCustody {
  SENDER
  COURIER
  DEPOT
  RECIPIENT
}

model User {
  id               String          @id @default(cuid())
  externalAuthId   String?         @unique
  email            String          @unique
  displayName      String
  role             UserRole        @default(OPERATOR)
  enabled          Boolean         @default(true)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
  createdShipments Shipment[]      @relation("ShipmentCreator")
  shipmentEvents   ShipmentEvent[] @relation("EventActor")
  customerRegistration CustomerRegistration? @relation("RegistrationUser")
  approvedRegistrations CustomerRegistration[] @relation("RegistrationApprover")
  customerDataChanges CustomerDataAudit[] @relation("CustomerDataActor")
  customerStatusChanges CustomerStatusAudit[] @relation("CustomerStatusActor")
  customerCreations CustomerCreationAudit[] @relation("CustomerCreationActor")
  invitationsReceived UserInvitation[] @relation("InvitationTarget")
  invitationsIssued UserInvitation[] @relation("InvitationIssuer")
  userCreationsMade UserCreationAudit[] @relation("UserCreationActor")
  creationAudit UserCreationAudit? @relation("UserCreationTarget")
  accessChangesMade UserAccessAudit[] @relation("AccessChangeActor")
  accessChangesReceived UserAccessAudit[] @relation("AccessChangeTarget")
  courierChanges CourierAudit[] @relation("CourierAuditActor")
  courierProfile Courier? @relation("CourierUser")
  receiptsUploaded ShipmentReceipt[] @relation("ReceiptUploader")
  receiptsReplaced ShipmentReceiptHistory[] @relation("ReceiptReplacer")
  pushDevices PushDevice[]

  @@index([role, enabled])
}

model Courier {
  id           String   @id @default(cuid())
  userId       String?  @unique
  user         User?    @relation("CourierUser", fields: [userId], references: [id], onDelete: Restrict)
  displayName  String
  active       Boolean  @default(true)
  custodyShipments Shipment[] @relation("CustodyCourier")
  available    Boolean  @default(true)
  vehicle      String?
  capacity     String?
  workingHours String?
  notes        String?
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  changes      CourierAudit[]
  shipments    Shipment[]

  @@index([displayName, id])
}

model CourierAudit {
  id          String   @id @default(cuid())
  courierId   String
  actorUserId String
  action      String
  fields      String[]
  occurredAt  DateTime @default(now()) @db.Timestamptz(3)
  courier     Courier  @relation(fields: [courierId], references: [id], onDelete: Restrict)
  actor       User     @relation("CourierAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([courierId, occurredAt])
}

model UserInvitation {
  id           String   @id @default(cuid())
  targetUserId String
  issuedById   String
  tokenHash    String   @unique
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime @db.Timestamptz(3)
  usedAt       DateTime? @db.Timestamptz(3)
  claimedSubject String?
  revokedAt    DateTime? @db.Timestamptz(3)
  target       User @relation("InvitationTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  issuer       User @relation("InvitationIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt])
}

model UserCreationAudit {
  id           String   @id @default(cuid())
  actorUserId  String
  targetUserId String   @unique
  role         UserRole
  occurredAt   DateTime @default(now()) @db.Timestamptz(3)
  actor        User @relation("UserCreationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  target       User @relation("UserCreationTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, occurredAt])
}

model UserAccessAudit {
  id              String   @id @default(cuid())
  actorUserId     String
  targetUserId    String
  previousRole    UserRole
  previousEnabled Boolean
  nextRole        UserRole
  nextEnabled     Boolean
  occurredAt      DateTime @default(now()) @db.Timestamptz(3)
  actor           User     @relation("AccessChangeActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  target          User     @relation("AccessChangeTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([targetUserId, occurredAt])
  @@index([actorUserId, occurredAt])
}

model Customer {
  id             String       @id @default(cuid())
  type           CustomerType
  displayName    String
  legalName      String?
  documentType   String?
  documentNumber String?
  email          String?
  phone          String?
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  addresses      Address[]
  shipments      Shipment[]
  registration   CustomerRegistration?
  creationAudit  CustomerCreationAudit?
  statusChanges  CustomerStatusAudit[]
  dataChanges    CustomerDataAudit[]

  @@index([documentType, documentNumber])
  @@index([enabled, displayName])
}

// A self-registration is separate from both the customer and its access account.
model CustomerRegistration {
  id          String   @id @default(cuid())
  customerId  String   @unique
  userId      String   @unique
  emailKey    String   @unique
  pending     Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  approvedAt  DateTime? @db.Timestamptz(3)
  approvedById String?
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  user        User @relation("RegistrationUser", fields: [userId], references: [id], onDelete: Restrict)
  approvedBy  User? @relation("RegistrationApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([pending, createdAt])
}

model CustomerDataAudit {
  id          String   @id @default(cuid())
  customerId  String
  addressId   String?
  actorUserId String
  action      String
  fields      String[]
  occurredAt  DateTime @default(now()) @db.Timestamptz(3)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  address     Address? @relation(fields: [addressId], references: [id], onDelete: Restrict)
  actor       User @relation("CustomerDataActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([customerId, occurredAt])
}

model CustomerStatusAudit {
  id              String   @id @default(cuid())
  customerId      String
  actorUserId     String
  previousEnabled Boolean
  nextEnabled     Boolean
  occurredAt      DateTime @default(now()) @db.Timestamptz(3)
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  actor           User @relation("CustomerStatusActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([customerId, occurredAt])
}

model CustomerCreationAudit {
  id          String   @id @default(cuid())
  customerId  String   @unique
  actorUserId String
  source      String
  occurredAt  DateTime @default(now()) @db.Timestamptz(3)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  actor       User @relation("CustomerCreationActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, occurredAt])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  label      String?
  street     String
  number     String
  locality   String
  department String
  reference  String?
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  dataChanges CustomerDataAudit[]

  @@index([customerId])
}

model Shipment {
  id                    String           @id @default(cuid())
  code                  String           @unique
  requestKey            String?          @unique
  customerId            String
  createdByUserId       String?
  senderName            String
  senderPhone           String?
  recipientName         String
  recipientPhone        String?
  pickupStreet          String
  pickupNumber          String
  pickupLocality        String
  pickupDepartment      String
  pickupReference       String?
  deliveryStreet        String
  deliveryNumber        String
  deliveryLocality      String
  deliveryDepartment    String
  deliveryReference     String?
  requestedPickupAt     DateTime?        @db.Timestamptz(3)
  requestedDeliveryAt   DateTime?        @db.Timestamptz(3)
  plannedFor            DateTime?        @db.Date
  plannedWindowStart    String?
  plannedWindowEnd      String?
  custody               ShipmentCustody?
  custodyCourierId      String?
  custodyCourier        Courier?         @relation("CustodyCourier", fields: [custodyCourierId], references: [id], onDelete: Restrict)
  custodyLocation        String?
  custodyVersion         Int              @default(0)
  assignedCourierId     String?
  assignedCourier       Courier?         @relation(fields: [assignedCourierId], references: [id], onDelete: Restrict)
  pickedUpAt            DateTime?        @db.Timestamptz(3)
  deliveredAt           DateTime?        @db.Timestamptz(3)
  status                ShipmentStatus   @default(PENDING)
  priority              ShipmentPriority @default(NORMAL)
  notes                 String?
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)
  customer              Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy             User?            @relation("ShipmentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  packages              Package[]
  events                ShipmentEvent[]
  receipt               ShipmentReceipt?
  receiptHistory        ShipmentReceiptHistory[]
  incidents             ShipmentIncident[]
  rescheduleProposals   RescheduleProposal[]

  @@index([customerId, createdAt])
  @@index([status, priority, createdAt])
  @@index([createdByUserId])
  @@index([assignedCourierId, status])
  @@index([plannedFor])
}

model RescheduleProposal {
  id String @id @default(cuid())
  requestKey String @unique
  shipmentId String
  actorUserId String
  actorLabel String
  proposedDate DateTime @db.Date
  windowStart String?
  windowEnd String?
  reason String
  nextAction String
  incidentId String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  decision RescheduleDecision?
  pushDeliveries PushDelivery[]
  @@index([shipmentId, createdAt])
}

model PushDevice {
  id String @id @default(cuid())
  userId String
  token String @unique
  enabled Boolean @default(true)
  validUntil DateTime @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveries PushDelivery[]
  @@index([userId, enabled])
}

model PushDelivery {
  id String @id @default(cuid())
  proposalId String
  deviceId String
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(3)
  ticketId String?
  lastError String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  proposal RescheduleProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  device PushDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  @@unique([proposalId, deviceId])
  @@index([status, nextAttemptAt])
}

model RescheduleDecision {
  id String @id @default(cuid())
  proposalId String @unique
  actorUserId String
  actorLabel String
  approved Boolean
  notes String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  proposal RescheduleProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
}

model ShipmentIncident {
  id String @id @default(cuid())
  requestKey String @unique
  shipmentId String
  actorUserId String
  actorLabel String
  phase String
  kind String
  description String
  nextAction String?
  failedAttempt Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  resolution IncidentResolution?
  evidence IncidentEvidence[]
  @@index([shipmentId, createdAt])
}

model IncidentEvidence {
  id String @id @default(cuid())
  requestKey String @unique
  incidentId String
  eventId String @unique
  actorUserId String
  actorLabel String
  storageKey String @unique
  mediaType String
  size Int
  sha256 String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  incident ShipmentIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  event ShipmentEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  @@index([incidentId, createdAt])
}

model IncidentResolution {
  id String @id @default(cuid())
  incidentId String @unique
  actorUserId String
  actorLabel String
  description String
  nextAction String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  incident ShipmentIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
}

model ShipmentReceiptHistory {
  id            String   @id @default(cuid())
  shipmentId    String
  replacedById  String
  oldUploaderId String
  oldMediaType  String
  oldSize       Int
  oldData       Bytes
  oldCreatedAt  DateTime @db.Timestamptz(3)
  replacedAt    DateTime @default(now()) @db.Timestamptz(3)
  shipment      Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  replacedBy    User @relation("ReceiptReplacer", fields: [replacedById], references: [id], onDelete: Restrict)

  @@index([shipmentId, replacedAt])
}

model ShipmentReceipt {
  id          String   @id @default(cuid())
  shipmentId  String   @unique
  uploadedById String
  mediaType   String
  size        Int
  version     Int      @default(1)
  data        Bytes
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  uploadedBy  User @relation("ReceiptUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
}

model Package {
  id          String   @id @default(cuid())
  shipmentId  String
  sequence    Int
  description String?
  weightKg    Decimal? @db.Decimal(10, 3)
  lengthCm    Decimal? @db.Decimal(10, 2)
  widthCm     Decimal? @db.Decimal(10, 2)
  heightCm    Decimal? @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, sequence])
}

model ShipmentEvent {
  id                String          @id @default(cuid())
  shipmentId        String
  actorUserId       String?
  actorLabel        String
  type              String
  previousStatus    ShipmentStatus?
  newStatus         ShipmentStatus?
  notes             String?
  occurredAt        DateTime        @default(now()) @db.Timestamptz(3)
  shipment          Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  actor             User?           @relation("EventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  evidence          CustodyEvidence?
  deliveryEvidence  DeliveryEvidence?
  incidentEvidence  IncidentEvidence?
  attachments       EventEvidence[] @relation("EvidenceTarget")
  attachmentEvent   EventEvidence? @relation("EvidenceAudit")

  @@index([shipmentId, occurredAt])
  @@index([actorUserId])
}

model EventEvidence {
  id String @id @default(cuid())
  requestKey String @unique
  targetEventId String
  auditEventId String @unique
  actorUserId String
  actorLabel String
  storageKey String @unique
  mediaType String
  size Int
  sha256 String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  targetEvent ShipmentEvent @relation("EvidenceTarget", fields: [targetEventId], references: [id], onDelete: Restrict)
  auditEvent ShipmentEvent @relation("EvidenceAudit", fields: [auditEventId], references: [id], onDelete: Restrict)
  @@index([targetEventId, createdAt])
}

model CustodyEvidence {
  id         String        @id @default(cuid())
  eventId    String        @unique
  mediaType  String
  size       Int
  data       Bytes
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  event      ShipmentEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
}

model DeliveryEvidence {
  id         String        @id @default(cuid())
  eventId    String        @unique
  storageKey String        @unique
  mediaType  String
  size       Int
  sha256     String
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  event      ShipmentEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
}

model LegacyFileCopy {
  id String @id @default(cuid())
  sourceKind String
  sourceId String
  sourceSha256 String
  storageKey String @unique
  mediaType String
  size Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([sourceKind, sourceId, sourceSha256])
}
